rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global pesticides are read-only for anyone authed
    match /pesticides/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "nayiffirat@gmail.com";
    }

    // Global news are read-only
    match /MKS/{orgId}/news/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "nayiffirat@gmail.com";
    }

    // Users can access their own data
    match /MKS/{orgId}/users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default allow for backward compatibility if I missed anything, but verify uid
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "nayiffirat@gmail.com";
    }

  }
}
