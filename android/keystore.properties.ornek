# Google Play Console İmzalama Anahtarı (Upload Key) Yapılandırması
# Play Console'a daha önce yüklediğiniz .jks veya .keystore dosyanızın bilgilerini buraya girip
# bu dosyanın adını "keystore.properties" olarak kaydedin:

storeFile=D:/MKS/upload-keystore.jks
storePassword=BURAYA_KEYSTORE_SIFRENIZI_YAZIN
keyAlias=upload
keyPassword=BURAYA_KEY_SIFRENIZI_YAZIN
