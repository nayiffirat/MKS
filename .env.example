# Mühendis Kayıt Sistemi (MKS) Sunucu Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın. Gerçek gizli anahtarları ASLA git deposuna eklemeyin.

FIREBASE_PROJECT_ID=muhendiskayitsistemi
GEMINI_API_KEY=

# Copernicus Data Space Ecosystem (Sentinel-2 L2A Ücretsiz Uydu Analizi)
# https://shapps.dataspace.copernicus.eu -> User Settings -> OAuth clients (MKS-Sentinel-Analiz)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
